{
  "name": "fanki",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Offline-first Dutch flashcards PWA for one French-speaking learner",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite --mode dev",
    "build": "npm run build:prod && npm run build:dev",
    "build:prod": "vite build --mode prod",
    "build:dev": "vite build --mode dev",
    "preview": "vite preview --mode dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "e2e": "npm run e2e:build && playwright test",
    "icons": "node scripts/make-icons.mjs",
    "check-secrets": "scripts/check-secrets.sh --tree",
    "gas:secrets:dev": "scripts/push-secrets.sh dev",
    "gas:secrets:prod": "scripts/push-secrets.sh prod",
    "gas:push:dev": "clasp -P .clasp.dev.json push -f",
    "gas:push:prod": "clasp -P .clasp.prod.json push -f",
    "gas:deploy:dev": "scripts/gas-deploy.sh dev",
    "gas:deploy:prod": "scripts/gas-deploy.sh prod",
    "smoke:dev": "scripts/smoke.sh dev",
    "smoke:prod": "scripts/smoke.sh prod",
    "admin": "node scripts/admin.mjs",
    "ui-strings": "node scripts/ui-strings.mjs",
    "ui-vocab": "node scripts/check-ui-vocab.mjs",
    "e2e:build": "FANKI_OUT_DIR=e2e-dist API_URL_DEV=https://mock.fanki.test/exec LEARNER_TOKEN_DEV=e2e-token vite build --mode dev",
    "backup:prod": "node scripts/backup.mjs prod"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "preact": "^10.29.8",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.3",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
